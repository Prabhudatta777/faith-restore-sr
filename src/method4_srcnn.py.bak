"""
Method 4: CNN-Based SR (SRCNN)
Curriculum Topics:
    - Convolutional Neural Networks and Applications
    - Recent Progress in Computer Vision

Paper: Dong et al. "Image Super-Resolution Using Deep Convolutional Networks" (ECCV 2014)

Architecture (SRCNN):
  Input: Bicubic-upsampled LR (H*4, W*4, 3)
  Conv 9x9, 64 filters + ReLU  -> Patch Extraction
  Conv 1x1, 32 filters + ReLU  -> Non-linear Mapping
  Conv 5x5, 3 filters           -> Reconstruction
  Output: SR (H*4, W*4, 3)

Training:
  Loss = MSE (SR vs HR)
  Optimizer = Adam, lr=1e-3
  Data = 70 train images, cropped to 64x64 HR patches (16x16 LR patches)

Usage:
  # Train (takes ~10-20 min on CPU, ~2-5 min on GPU)
  python -m src.method4_srcnn --train --epochs 30

  # Evaluate only (loads saved checkpoint)
  python -m src.method4_srcnn --eval
"""

import argparse
import 【entity-torch¦canonical_name=torch】
import 【entity-torch¦canonical_name=torch】.nn as nn
import 【entity-torch¦canonical_name=torch】.nn.functional as F
from pathlib import Path
from 【entity-torch¦canonical_name=torch】.utils.data import DataLoader
from tqdm import tqdm

from src.dataset import BSD100SRDataset
from src.utils import set_seed, evaluate_method, calculate_psnr, calculate_ssim, tensor_to_numpy

# --------------------------------------------------
# 1. SRCNN Model
# --------------------------------------------------
class SRCNN(nn.Module):
    def __init__(self, num_channels: int = 3):
        super().__init__()
        # Layer 1: Patch Extraction
        # 9x9 kernel, 64 filters - large receptive field to see context
        self.conv1 = nn.Conv2d(num_channels, 64, kernel_size=9, padding=4)
        # Layer 2: Non-linear Mapping
        # 1x1 kernel, 32 filters - maps LR features to HR features
        self.conv2 = nn.Conv2d(64, 32, kernel_size=1, padding=0)
        # Layer 3: Reconstruction
        # 5x5 kernel, 3 filters - builds final RGB image
        self.conv3 = nn.Conv2d(32, num_channels, kernel_size=5, padding=2)
        self.relu = nn.ReLU(inplace=True)

    def forward(self, x):
        x = self.relu(self.conv1(x))
        x = self.relu(self.conv2(x))
        x = self.conv3(x)
        return x

def bicubic_upsample(lr: 【entity-torch¦canonical_name=torch】.Tensor, scale: int = 4) -> 【entity-torch¦canonical_name=torch】.Tensor:
    """Upsample LR (small) to HR size with bicubic - SRCNN input."""
    return F.interpolate(lr, scale_factor=scale, mode="bicubic", align_corners=False)

# --------------------------------------------------
# 2. Training
# --------------------------------------------------
CHECKPOINT = Path("results/method4_srcnn/srcnn_best.pth")

def train(epochs: int = 30, batch_size: int = 16, lr: float = 1e-3):
    set_seed(42)
    device = "cuda" if 【entity-torch¦canonical_name=torch】.cuda.is_available() else "cpu"
    print(f"Training on: {device}")

    # Datasets
    # dataset.py already crops to 64x64 HR / 16x16 LR patches for train
    train_ds = BSD100SRDataset(split="train", patch_size=64, augment=True)
    val_ds = BSD100SRDataset(split="val")

    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True, num_workers=0)
    val_loader = DataLoader(val_ds, batch_size=1, shuffle=False)

    print(f"Train: {len(train_ds)} images | Val: {len(val_ds)} images")

    model = SRCNN().to(device)
    optimizer = 【entity-torch¦canonical_name=torch】.optim.Adam(model.parameters(), lr=lr)
    criterion = nn.MSELoss()

    # LR scheduler - reduce LR when val PSNR plateaus
    scheduler = 【entity-torch¦canonical_name=torch】.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="max", factor=0.5, patience=5, verbose=True
    )

    best_psnr = 0.0
    CHECKPOINT.parent.mkdir(parents=True, exist_ok=True)

    for epoch in range(1, epochs + 1):
        model.train()
        train_loss = 0.0

        # Note: Our Dataset returns 1 patch per __getitem__ call,
        # but DataLoader batches them. For true patch training,
        # each epoch sees len(train_ds) = 70 samples.
        # To get more patches per epoch, we loop 20x over dataset.
        # Simple trick: repeat loader 20 times = 1400 patches / epoch
        pbar = tqdm(range(20), desc=f"Epoch {epoch}/{epochs}")
        for _ in pbar:
            for lr, hr, _ in train_loader:
                lr, hr = lr.to(device), hr.to(device)

                # SRCNN takes bicubic-upsampled input
                lr_up = bicubic_upsample(lr, scale=4)

                optimizer.zero_grad()
                sr = model(lr_up)
                sr = 【entity-torch¦canonical_name=torch】.clamp(sr, 0, 1)
                loss = criterion(sr, hr)
                loss.backward()
                optimizer.step()

                train_loss += loss.item()
                pbar.set_postfix(loss=f"{loss.item():.5f}")

        # ---- Validation ----
        model.eval()
        psnr_list = []
        with 【entity-torch¦canonical_name=torch】.no_grad():
            for lr, hr, _ in val_loader:
                lr, hr = lr.to(device), hr.to(device)
                lr_up = bicubic_upsample(lr, scale=4)
                sr = 【entity-torch¦canonical_name=torch】.clamp(model(lr_up), 0, 1)

                hr_np = tensor_to_numpy(hr[0])
                sr_np = tensor_to_numpy(sr[0])
                psnr_list.append(calculate_psnr(hr_np, sr_np))

        avg_val_psnr = sum(psnr_list) / len(psnr_list)
        scheduler.step(avg_val_psnr)

        print(f"Epoch {epoch}: Train Loss {train_loss:.4f} | Val PSNR {avg_val_psnr:.2f} dB")

        # Save best
        if avg_val_psnr > best_psnr:
            best_psnr = avg_val_psnr
            【entity-torch¦canonical_name=torch】.save(model.state_dict(), CHECKPOINT)
            print(f"  -> Saved BEST model (PSNR {best_psnr:.2f}) to {CHECKPOINT}")

    print(f"\nTraining done! Best Val PSNR: {best_psnr:.2f} dB")
    print(f"Checkpoint: {CHECKPOINT}")

# --------------------------------------------------
# 3. Evaluation (Test set)
# --------------------------------------------------
# Global model for evaluate_method wrapper
_MODEL = None
_DEVICE = "cuda" if 【entity-torch¦canonical_name=torch】.cuda.is_available() else "cpu"

def srcnn_method(lr_tensor: 【entity-torch¦canonical_name=torch】.Tensor) -> 【entity-torch¦canonical_name=torch】.Tensor:
    global _MODEL
    lr_up = bicubic_upsample(lr_tensor.to(_DEVICE), scale=4)
    with 【entity-torch¦canonical_name=torch】.no_grad():
        sr = _MODEL(lr_up)
    return 【entity-torch¦canonical_name=torch】.clamp(sr.cpu(), 0, 1)

def evaluate():
    global _MODEL
    set_seed(42)

    if not CHECKPOINT.exists():
        print(f"ERROR: No checkpoint found at {CHECKPOINT}")
        print("Run training first: python -m src.method4_srcnn --train --epochs 30")
        return

    print("=" * 55)
    print("METHOD 4: 【entity-CNN¦canonical_name=CNN】 (SRCNN) - EVALUATION (x4)")
    print("=" * 55)

    _MODEL = SRCNN().to(_DEVICE)
    _MODEL.load_state_dict(【entity-torch¦canonical_name=torch】.load(CHECKPOINT, map_location=_DEVICE))
    _MODEL.eval()
    print(f"Loaded checkpoint: {CHECKPOINT}")

    # Count parameters - nice for report
    n_params = sum(p.numel() for p in _MODEL.parameters())
    print(f"SRCNN Parameters: {n_params:,}")

    test_ds = BSD100SRDataset(split="test")
    test_loader = DataLoader(test_ds, batch_size=1, shuffle=False)
    print(f"Test images: {len(test_ds)}")

    results = evaluate_method(
        sr_function=srcnn_method,
        dataloader=test_loader,
        save_dir=Path("results/method4_srcnn"),
        max_save=3
    )

    out_path = Path("results/method4_srcnn/results.txt")
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with open(out_path, "w") as f:
        f.write("Method 4: 【entity-CNN¦canonical_name=CNN】 (SRCNN) (x4) - BSD100\n")
        f.write("=" * 40 + "\n")
        f.write(f"Parameters: {n_params}\n")
        f.write(f"Avg PSNR: {results['avg_psnr']:.2f} dB\n")
        f.write(f"Avg SSIM: {results['avg_ssim']:.4f}\n")
        f.write(f"Images: {results['num_images']}\n")

    print(f"\nResults saved to: {out_path}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--train", action="store_true", help="Train SRCNN")
    parser.add_argument("--eval", action="store_true", help="Evaluate SRCNN on test set")
    parser.add_argument("--epochs", type=int, default=30, help="Training epochs")
    args = parser.parse_args()

    # Default: if no flag, do both train + eval
    if not args.train and not args.eval:
        args.train = True
        args.eval = True

    if args.train:
        train(epochs=args.epochs)

    if args.eval:
        evaluate()